# ---------------------------------------------------------------------------
# OmniRadar environment variables
#
# Copy this file to .env.local and fill in the values:
#   cp .env.example .env.local
#
# .env.local is gitignored. NEVER commit real values, and never paste them
# into chats, issues, or screenshots.
# Run `npm run verify` after filling this in to check every credential.
# ---------------------------------------------------------------------------

# --- Supabase ---------------------------------------------------------------
# Supabase dashboard -> your project -> Project Settings -> API Keys
# Project URL, e.g. https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# "Publishable" key (sb_publishable_...). Safe to expose to the browser because
# row level security protects every table. The legacy "anon" key also works.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# "Secret" key (sb_secret_...). SERVER ONLY. Bypasses row level security.
# The legacy "service_role" key also works.
SUPABASE_SECRET_KEY=

# --- Plaid ------------------------------------------------------------------
# Plaid dashboard -> Developers -> Keys  (https://dashboard.plaid.com/developers/keys)
PLAID_CLIENT_ID=

# Use the secret that matches PLAID_ENV below (sandbox and production differ).
PLAID_SECRET=

# "sandbox" for fake test banks, "production" for your real accounts.
PLAID_ENV=sandbox

# Optional. Public HTTPS URL Plaid calls when new data is ready, e.g.
# https://your-tunnel.example.com/api/plaid/webhook  (leave blank locally)
PLAID_WEBHOOK_URL=

# Optional. Only needed if a bank's OAuth flow requires a redirect. Must also be
# registered in Plaid dashboard -> Developers -> API -> Allowed redirect URIs.
PLAID_REDIRECT_URI=

# --- App secrets ------------------------------------------------------------
# 32-byte key used to encrypt Plaid access tokens before they hit the database.
# Generate with:  openssl rand -base64 32
# If you lose or change this key, linked banks must be re-linked.
TOKEN_ENCRYPTION_KEY=

# Shared secret for the scheduled sync endpoint (/api/cron/sync).
# Generate with:  openssl rand -hex 32
CRON_SECRET=
